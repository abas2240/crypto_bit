def calculate_18_indicators_and_filter_fake(df):
    try:
        df['RSI'] = ta.rsi(df['close'], length=14)
        stoch = ta.stoch(df['high'], df['low'], df['close'])
        df['STOCHk'] = stoch.iloc[:, 0]
        df['STOCHd'] = stoch.iloc[:, 1]
        macd = ta.macd(df['close'])
        df['MACD'] = macd.iloc[:, 0]

        last = df.iloc[-1]
        prev = df.iloc[-2]

        is_stoch_fake = False
        if last['STOCHk'] > 80 and last['STOCHd'] > 80 and last['MACD'] < prev['MACD']:
            is_stoch_fake = True
        elif last['STOCHk'] < 20 and last['STOCHd'] < 20 and last['MACD'] > prev['MACD']:
            is_stoch_fake = True

        if is_stoch_fake:
            return False, last['close'], last['volume'], last['RSI'], 0

        return True, last['close'], last['volume'], last['RSI'], 16
    except Exception as e:
        logger.error(f"Error: {e}")
        return False, 0, 0, 0, 0

def fetch_and_analyze_market(exchange_names, symbol="PEPE/USDT"):
    for name in exchange_names:
        try:
            exchange_class = getattr(ccxt, name)
            exchange = exchange_class({'enableRateLimit': True})
            exchange.load_markets()
            if symbol in exchange.markets:
                ohlcv = exchange.fetch_ohlcv(symbol, timeframe='1h', limit=100)
                df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
                is_valid, price, volume, rsi, score = calculate_18_indicators_and_filter_fake(df)
                if not is_valid:
                    continue
                ticker = exchange.fetch_ticker(symbol)
                return name.upper(), price, ticker.get('quoteVolume', volume), rsi, score
        except Exception as e:
            continue
    return None, 0, 0, 0, 0

def format_price(price):
    if price < 0.0001:
        return f"{price:.8f}"
    elif price < 1:
        return f"{price:.4f}"
    else:
        return f"{price:.2f}"

